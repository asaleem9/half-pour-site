---
import { site, isLive } from "@/lib/config";

interface Props {
  size?: "regular" | "hero";
  class?: string;
}
const { size = "regular", class: className = "" } = Astro.props;
const sizeClass = size === "hero" ? "hp-btn--hero" : "";
---

{
  isLive ? (
    <a href={site.appStoreUrl} class={`hp-btn hp-btn--ink ${sizeClass} ${className}`} data-cta="app-store" data-sound="pop">
      <svg viewBox="0 0 24 24" width={size === "hero" ? 30 : 22} height={size === "hero" ? 30 : 22} fill="currentColor" aria-hidden="true">
        <path d="M16.37 12.76c-.02-2.4 1.96-3.56 2.05-3.62-1.12-1.64-2.86-1.86-3.48-1.89-1.48-.15-2.89.87-3.64.87-.75 0-1.91-.85-3.14-.83-1.61.02-3.1.94-3.93 2.38-1.68 2.91-.43 7.21 1.21 9.57.8 1.16 1.75 2.46 3 2.41 1.2-.05 1.66-.78 3.11-.78 1.45 0 1.86.78 3.13.75 1.3-.02 2.12-1.18 2.91-2.34.92-1.34 1.3-2.64 1.32-2.71-.03-.01-2.53-.97-2.54-3.81zM14 5.7c.66-.8 1.11-1.92.99-3.03-.95.04-2.11.64-2.79 1.44-.61.71-1.15 1.85-1.01 2.94 1.06.08 2.15-.54 2.81-1.35z" />
      </svg>
      <span class="flex flex-col items-start leading-none">
        <span class="text-[0.62em] font-semibold opacity-80">Download on the</span>
        <span>App Store</span>
      </span>
    </a>
  ) : (
    <span class={`hp-btn ${sizeClass} ${className}`} role="link" aria-disabled="true" data-cta="app-store-soon">
      <svg viewBox="0 0 24 24" width={size === "hero" ? 30 : 22} height={size === "hero" ? 30 : 22} fill="currentColor" aria-hidden="true">
        <path d="M16.37 12.76c-.02-2.4 1.96-3.56 2.05-3.62-1.12-1.64-2.86-1.86-3.48-1.89-1.48-.15-2.89.87-3.64.87-.75 0-1.91-.85-3.14-.83-1.61.02-3.1.94-3.93 2.38-1.68 2.91-.43 7.21 1.21 9.57.8 1.16 1.75 2.46 3 2.41 1.2-.05 1.66-.78 3.11-.78 1.45 0 1.86.78 3.13.75 1.3-.02 2.12-1.18 2.91-2.34.92-1.34 1.3-2.64 1.32-2.71-.03-.01-2.53-.97-2.54-3.81zM14 5.7c.66-.8 1.11-1.92.99-3.03-.95.04-2.11.64-2.79 1.44-.61.71-1.15 1.85-1.01 2.94 1.06.08 2.15-.54 2.81-1.35z" />
      </svg>
      <span class="flex flex-col items-start leading-none">
        <span class="text-[0.62em] font-semibold opacity-80">Coming soon to the</span>
        <span>App Store</span>
      </span>
    </span>
  )
}
