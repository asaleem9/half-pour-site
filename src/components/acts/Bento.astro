---
/**
 * Act 5. What you get: six tiles. Four hold live HyperFrames loops with Pourie (played by HfPlayer when it
 * is on screen), one holds a real screenshot that follows day and night, one lists the guides.
 */
import HfPlayer from "@/components/media/HfPlayer.astro";

const loops = [
  {
    name: "loop-lock-screen",
    title: "Log it without unlocking.",
    body: "One tap from the Live Activity on your Lock Screen, a Home Screen widget or Control Center.",
    label: "Animation: a drink is logged with one tap on a Lock Screen card, then a water.",
    span: "lg:col-span-7",
    wide: true,
  },
  {
    name: "loop-water-round",
    title: "Water rounds.",
    body: "The pace ring fills, the app says water, and the score remembers.",
    label: "Animation: a pace ring fills and turns into a water round while Pourie sips water.",
    span: "lg:col-span-5",
    wide: false,
  },
  {
    name: "loop-nothing-resets",
    title: "Weeks that add up.",
    body: "Streaks are weeks, with a shield for the one that gets away. Nothing resets.",
    label: "Animation: six weekly tokens; one tips over, a shield covers it, and the count stays at six.",
    span: "lg:col-span-5",
    wide: false,
  },
  {
    name: "loop-kudos",
    title: "A crew that only sees the good stuff.",
    body: "Night Scores, badges and dry nights. Never how many you had. Kudos only: no comments, no leaderboards.",
    label: "Animation: three Pouries pass heart stickers to each other.",
    span: "lg:col-span-7",
    wide: true,
  },
];
const guides = ["One an hour", "Rounds without the pressure", "Saying no without it being a thing", "Zebra striping", "Pre-game math", "The morning after", "Sleep", "Hangxiety"];
---

<section id="features" class="relative mx-auto max-w-[1400px] px-5 py-[clamp(5rem,12vw,10rem)] sm:px-8" aria-labelledby="features-title">
  <h2 id="features-title" class="text-display">What you get.</h2>
  <p class="mt-6 max-w-[40ch] text-lede text-muted">Everything is built around one idea: the easiest way to cut back is to see the night clearly, without being told off.</p>

  <div class="mt-[clamp(2.5rem,6vw,4.5rem)] grid gap-5 lg:grid-cols-12">
    {
      loops.map((loop) => (
        <article class:list={["bento-tile hp-card overflow-hidden p-0", loop.span, loop.wide && "bento-wide"]}>
          <HfPlayer name={loop.name} label={loop.label} class="bento-media" />
          <div class="p-6 sm:p-8">
            <h3 class="text-title">{loop.title}</h3>
            <p class="mt-3 max-w-[38ch] text-lede text-muted">{loop.body}</p>
          </div>
        </article>
      ))
    }

    <article class="bento-tile hp-card bento-shot overflow-hidden p-0 lg:col-span-6">
      <div class="p-6 sm:p-8">
        <h3 class="text-title">See what actually tips a night over.</h3>
        <p class="mt-3 max-w-[38ch] text-lede text-muted">Insights lines up your mornings against your nights, in your own data.</p>
      </div>
      <div class="bento-screen mx-auto" aria-hidden="true">
        <img src="/screens/insights-light-720.webp" srcset="/screens/insights-light-360.webp 360w, /screens/insights-light-720.webp 720w" sizes="(max-width: 640px) 70vw, 340px" alt="" width="720" height="1564" loading="lazy" decoding="async" class="dark:hidden" />
        <img src="/screens/insights-dark-720.webp" srcset="/screens/insights-dark-360.webp 360w, /screens/insights-dark-720.webp 720w" sizes="(max-width: 640px) 70vw, 340px" alt="" width="720" height="1564" loading="lazy" decoding="async" class="hidden dark:block" />
      </div>
    </article>

    <article class="bento-tile hp-card hp-card--raised flex flex-col justify-between p-6 sm:p-8 lg:col-span-6">
      <div>
        <h3 class="text-title">Short guides for the tricky moments.</h3>
        <p class="mt-3 max-w-[38ch] text-lede text-muted">Two-minute reads for the parts of a night that nobody plans for.</p>
      </div>
      <ul class="mt-8 flex flex-wrap gap-2.5">
        {guides.map((guide) => <li class="hp-chip border-outline bg-surface px-4 py-3 text-base">{guide}</li>)}
      </ul>
      <img src="/art/pourie-read-480.webp" alt="" width="300" height="300" loading="lazy" decoding="async" class="bento-reader mt-6 w-36 self-end sm:w-44" />
    </article>
  </div>
</section>

<style>
  .bento-tile {
    display: flex;
    flex-direction: column;
  }
  .bento-tile :global(.bento-media) {
    width: 100%;
    aspect-ratio: 1;
    border-bottom: 2px solid var(--line);
  }
  @media (min-width: 720px) {
    .bento-wide {
      flex-direction: row;
      align-items: center;
    }
    .bento-wide :global(.bento-media) {
      width: 50%;
      flex: none;
      border-bottom: 0;
      border-right: 2px solid var(--line);
    }
  }
  .bento-shot {
    justify-content: space-between;
  }
  .bento-screen {
    width: min(74%, 340px);
    height: clamp(260px, 34vw, 420px);
    overflow: hidden;
    border: 5px solid var(--outline);
    border-bottom: 0;
    border-radius: 34px 34px 0 0;
    background: var(--surface);
  }
  .bento-screen img {
    width: 100%;
    height: auto;
  }
  .bento-reader {
    height: auto;
  }
  /* Tiles rise into place as they enter the viewport, where the browser can tie animation to scroll. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bento-tile {
        animation: bento-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes bento-rise {
    from {
      opacity: 0;
      transform: translateY(48px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
