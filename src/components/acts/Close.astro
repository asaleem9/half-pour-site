---
/**
 * Act 8. The close: an amber ground, Pourie waving in a cream disc, the name, the line and the badge.
 * It holds still; one burst of confetti greets the visitor when it scrolls in (behaviours/close.ts).
 */
import AppStoreBadge from "@/components/AppStoreBadge.astro";
import Pourie from "@/components/rig/Pourie.astro";

// Confetti: where each piece rests, as a percentage of the section, with its size, colour and turn.
const confetti = [
  [8, 16, 56, 30, "#1FC98A", -18], [88, 20, 34, 60, "#9B7BF7", 22], [14, 52, 34, 56, "#FF6FA3", 14], [91, 58, 58, 30, "#FFF6E5", -24],
  [6, 82, 40, 40, "#9B7BF7", 30], [94, 86, 40, 40, "#1FC98A", -12], [80, 8, 40, 40, "#FF6FA3", 40], [22, 30, 30, 30, "#FFF6E5", 12],
  [72, 78, 44, 26, "#3DB2FF", 16], [30, 88, 30, 48, "#FFF6E5", -30],
] as const;
---

<section id="get" class="close relative isolate overflow-clip bg-amber text-indigo" data-close-act aria-labelledby="close-title">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {
      confetti.map(([x, y, w, h, colour, turn]) => (
        <span class="close-bit absolute" data-close-bit style={`left:${x}%;top:${y}%;width:${w}px;height:${h}px;background:${colour};--turn:${turn}deg`} />
      ))
    }
  </div>

  <div class="relative mx-auto flex max-w-[1100px] flex-col items-center px-5 py-[clamp(5rem,12vw,9rem)] text-center sm:px-8">
    <div class="close-disc relative grid place-items-center rounded-full bg-cream" data-close-disc>
      <Pourie id="close-pourie" class="w-[72%]" />
    </div>

    <h2 id="close-title" class="mt-10 text-hero" data-close-title>Half Pour</h2>
    <p class="close-line mt-6 rounded-full bg-cream px-8 py-4 font-display text-[clamp(1.6rem,4.4vw,3.2rem)] font-semibold leading-none" data-close-line>Cut back, not out.</p>

    <div class="mt-10" data-close-cta>
      <AppStoreBadge size="hero" class="close-badge" />
    </div>
    <p class="mt-8 max-w-[44ch] font-semibold">For adults aged 18 and over. Half Pour is a tracker, not a medical device.</p>
  </div>
</section>

<style>
  .close-disc {
    width: min(64vw, 420px);
    aspect-ratio: 1;
    border: 5px solid #1f1a3d;
    box-shadow: 0 14px 0 #c97700;
  }
  .close-line {
    border: 5px solid #1f1a3d;
    box-shadow: 0 12px 0 #1f1a3d;
  }
  .close-bit {
    border: 4px solid #1f1a3d;
    border-radius: 10px;
    transform: rotate(var(--turn));
  }
  /* On amber the placeholder badge needs the cream face, whatever the theme. */
  .close :global(.close-badge[aria-disabled="true"]) {
    --face: #fff6e5;
    --edge: #1f1a3d;
    --label: #1f1a3d;
    border: 4px solid #1f1a3d;
  }
  @media (max-width: 640px) {
    .close-bit {
      scale: 0.6;
    }
    /* On a phone the lower pieces would land on the words, so only the ones around the disc stay. */
    .close-bit:nth-child(n + 3):not(:nth-child(7)):not(:nth-child(8)) {
      display: none;
    }
  }
</style>

<script>
  import "@/behaviours/close";
</script>
