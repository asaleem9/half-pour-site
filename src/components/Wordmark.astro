---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<a href="/" class={`group inline-flex items-center gap-2.5 no-underline ${className}`} aria-label="Half Pour, home">
  <svg viewBox="0 0 40 46" width="34" height="39" aria-hidden="true" class="shrink-0 transition-transform duration-300 ease-(--ease-snappy) group-hover:-rotate-6">
    <!-- A small half-full tumbler: the mark. -->
    <path d="M5.5 4.5h29l-3.2 34.2a3.6 3.6 0 0 1-3.6 3.3H12.3a3.6 3.6 0 0 1-3.6-3.3L5.5 4.5z" fill="#FFF6E5" />
    <path d="M7.3 23c3-1.8 5.6-1.8 8.4 0s5.6 1.8 8.4 0 5.6-1.8 8.6 0l-1.4 15.7a3.6 3.6 0 0 1-3.6 3.3H12.3a3.6 3.6 0 0 1-3.6-3.3L7.3 23z" fill="#FFB02E" />
    <path d="M5.5 4.5h29l-3.2 34.2a3.6 3.6 0 0 1-3.6 3.3H12.3a3.6 3.6 0 0 1-3.6-3.3L5.5 4.5z" fill="none" stroke="var(--outline)" stroke-width="3.4" stroke-linejoin="round" />
    <path d="M12.2 10.5l.8 8" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" />
    <circle cx="15.6" cy="30.4" r="1.9" fill="#1F1A3D" />
    <circle cx="24.4" cy="30.4" r="1.9" fill="#1F1A3D" />
    <path d="M17.2 34.6c1.7 1.6 3.9 1.6 5.6 0" fill="none" stroke="#1F1A3D" stroke-width="1.8" stroke-linecap="round" />
  </svg>
  <span class="font-display text-[1.45rem] font-bold leading-none tracking-[0.005em] text-ink">Half Pour</span>
</a>
