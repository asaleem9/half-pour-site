---
import Base from "@/layouts/Base.astro";
import AppStoreBadge from "@/components/AppStoreBadge.astro";

const points = [
  { title: "Pick tonight's number before you go out", body: "One page: your number, a pace, a last call and a ride home." },
  { title: "Log a drink in one tap", body: "From the Lock Screen, a widget or Control Center. Water rounds count too." },
  { title: "A score for the night. Never a fail.", body: "Close the tab and see where every point came from." },
  { title: "Two taps the morning after", body: "Say how you feel. That is the whole check-in." },
  { title: "Weeks that add up. Nothing resets.", body: "Streaks are weeks, with a shield for the one that gets away." },
  { title: "Badges for pacing, water and showing up", body: "Thirty-one of them. None for drinking more." },
];
---

<Base>
  <section class="relative mx-auto flex min-h-svh max-w-[1400px] flex-col justify-center px-5 pb-16 pt-28 sm:px-8">
    <h1 class="text-hero">Cut back,<br />not out.</h1>
    <p class="mt-8 max-w-[34ch] text-lede text-muted">
      Half Pour is for people who want lighter mornings without giving up the night. Plan it, log each drink in one tap, and wake up to an
      honest, kind recap.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <AppStoreBadge size="hero" />
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 pb-28 sm:px-8" aria-labelledby="what">
    <h2 id="what" class="text-display">What it does</h2>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        points.map((point) => (
          <li class="hp-card p-6">
            <h3 class="text-2xl leading-tight">{point.title}</h3>
            <p class="mt-3 text-muted">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
