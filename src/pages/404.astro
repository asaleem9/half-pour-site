---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found" plain noindex>
  <section class="mx-auto flex min-h-svh max-w-[900px] flex-col items-start justify-center px-5 pb-16 pt-28 sm:px-8">
    <img src="/art/pourie-search-480.webp" alt="Pourie looking through a magnifying glass" width="220" height="220" decoding="async" class="mb-6 h-auto w-44" />
    <p class="font-display text-lg font-semibold text-brand-ink">404</p>
    <h1 class="mt-2 text-display">Nothing poured here.</h1>
    <p class="mt-6 max-w-[40ch] text-lede text-muted">That page does not exist. The front door does.</p>
    <a href="/" class="hp-btn mt-10">Back to the start</a>
  </section>
</Base>
