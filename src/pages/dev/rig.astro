---
import Base from "@/layouts/Base.astro";
import Pourie from "@/components/rig/Pourie.astro";
---

<Base title="Pourie rig" plain noindex>
  <section class="mx-auto max-w-[1300px] px-5 pb-24 pt-28 sm:px-8">
    <h1 class="text-title">Pourie, drawn in code</h1>
    <p class="mt-3 max-w-[60ch] text-muted">Left: the character sheet. Middle: the vector rig laid over the sheet. Right: the rig alone. Use the day and night chip to see both grounds.</p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <figure class="hp-card p-4">
        <img src="/dev/sheet-main.png" alt="Pourie on the character sheet" width="640" height="720" class="w-full rounded-xl" />
        <figcaption class="mt-3 font-display font-semibold">Character sheet</figcaption>
      </figure>
      <figure class="hp-card p-4">
        <div class="relative">
          <img src="/dev/sheet-main.png" alt="" width="640" height="720" class="w-full rounded-xl" />
          <Pourie id="onion" class="absolute inset-0 w-full opacity-60" />
        </div>
        <figcaption class="mt-3 font-display font-semibold">Rig over the sheet (60%)</figcaption>
      </figure>
      <figure class="hp-card p-4">
        <div class="rounded-xl bg-canvas">
          <Pourie id="solo" class="w-full" label="Pourie waving" />
        </div>
        <figcaption class="mt-3 font-display font-semibold">Rig alone</figcaption>
      </figure>
    </div>

    <div class="hp-card mt-8 grid gap-6 p-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]" data-rig-stage>
      <div class="rounded-xl bg-raised p-4">
        <Pourie id="live" class="mx-auto w-full max-w-[420px]" label="Pourie, live" />
      </div>
      <div>
        <h2 class="text-2xl">Try the moves</h2>
        <p class="mt-2 text-muted">Move the pointer and the eyes follow. Tap Pourie to hop.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <button type="button" class="hp-btn hp-btn--compact" data-move="wave">Wave</button>
          <button type="button" class="hp-btn hp-btn--compact" data-move="hop">Hop</button>
          <button type="button" class="hp-btn hp-btn--compact" data-move="cheer">Cheer</button>
          <button type="button" class="hp-btn hp-btn--compact hp-btn--secondary" data-move="blink">Blink</button>
          <button type="button" class="hp-btn hp-btn--compact hp-btn--secondary" data-move="slosh">Slosh</button>
          <button type="button" class="hp-btn hp-btn--compact hp-btn--secondary" data-move="arm">Arm down / up</button>
          <button type="button" class="hp-btn hp-btn--compact hp-btn--secondary" data-move="mouth">Change mouth</button>
          <button type="button" class="hp-btn hp-btn--compact hp-btn--secondary" data-move="eyes">Happy eyes</button>
          <button type="button" class="hp-btn hp-btn--compact hp-btn--water" data-move="hold">Hold a water</button>
        </div>
        <label class="mt-6 block font-display font-semibold" for="walk">Walk (drag)</label>
        <input id="walk" type="range" min="0" max="4" step="0.01" value="0" class="mt-2 w-full accent-(--brand)" data-walk />
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-3" data-rig-lab>
      <figure class="rounded-[24px] bg-night p-6">
        <Pourie id="night" class="pourie-rig--edge mx-auto w-2/3" />
        <figcaption class="mt-3 font-display font-semibold text-cream">On night, with the sticker edge</figcaption>
      </figure>
      <figure class="rounded-[24px] bg-amber p-6">
        <Pourie id="amber" class="pourie-rig--edge mx-auto w-2/3" />
        <figcaption class="mt-3 font-display font-semibold text-indigo">On amber</figcaption>
      </figure>
      <figure class="hp-card p-6">
        <img src="/dev/pourie-wave.png" alt="The generated waving pose" width="720" height="720" class="mx-auto w-2/3" />
        <figcaption class="mt-3 font-display font-semibold">Generated art, same pose</figcaption>
      </figure>
    </div>
  </section>
</Base>

<script>
  import { createRig, followPointer, type Mouth } from "@/behaviours/rig";

  const svg = document.querySelector<SVGSVGElement>('[data-rig="live"]');
  if (svg) {
    const rig = createRig(svg, { idle: true });
    followPointer(rig);
    svg.addEventListener("click", () => rig.hop());
    let armDown = false;
    let happy = false;
    let holding = false;
    const mouths: Mouth[] = ["open", "smile", "oh"];
    let mouth = 0;
    const moves: Record<string, () => void> = {
      wave: () => rig.wave(),
      hop: () => rig.hop(),
      cheer: () => rig.cheer(),
      blink: () => rig.blink(),
      slosh: () => rig.slosh(30),
      arm: () => rig.setArm((armDown = !armDown) ? "down" : "wave"),
      mouth: () => rig.setMouth(mouths[(mouth = (mouth + 1) % mouths.length)]),
      eyes: () => rig.setEyes((happy = !happy) ? "happy" : "open"),
      hold: () => rig.hold((holding = !holding) ? "/dev/prop-water.png" : null),
    };
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-move]")) {
      button.addEventListener("click", () => moves[button.dataset.move ?? ""]?.());
    }
    const slider = document.querySelector<HTMLInputElement>("[data-walk]");
    slider?.addEventListener("input", () => {
      rig.setIdle(false);
      rig.walk(Number(slider.value), 0.6);
    });
    slider?.addEventListener("change", () => {
      rig.stand();
      rig.setIdle(true);
    });
    // Static poses for the night and amber cards, so both grounds show more than the resting pose.
    const night = document.querySelector<SVGSVGElement>('[data-rig="night"]');
    if (night) {
      const pose = createRig(night);
      pose.setEyes("happy");
      pose.setArm("up", true);
    }
    const amber = document.querySelector<SVGSVGElement>('[data-rig="amber"]');
    if (amber) {
      const pose = createRig(amber);
      pose.setArm("down", true);
      pose.setMouth("smile");
      pose.walk(0.2, 0.6);
    }
    Object.assign(window, { __rig: rig });
  }
</script>
