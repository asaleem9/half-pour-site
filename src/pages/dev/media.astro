---
import Base from "@/layouts/Base.astro";
import HfPlayer from "@/components/media/HfPlayer.astro";
import AlphaBurst from "@/components/media/AlphaBurst.astro";

const loops = [
  { name: "loop-lock-screen", title: "One tap from the Lock Screen", label: "A Lock Screen card: a tap on the beer button fills the third of four tokens, then a tap on water; Pourie hops." },
  { name: "loop-water-round", title: "Water round", label: "A pace ring fills around a clock, turns blue, and a Water round pill pops while Pourie sips." },
  { name: "loop-nothing-resets", title: "Nothing resets", label: "Six week tokens and a big six. One token tips over, a shield lands on it, it stands back up. The six never changes." },
  { name: "loop-kudos", title: "Kudos", label: "Three crew-mates pass a pink heart round in turn." },
];
const bursts = [
  { name: "burst-badge", title: "Badge burst" },
  { name: "burst-cheer", title: "Cheer burst" },
];
---

<Base title="Motion pieces" plain noindex>
  <section class="mx-auto max-w-[1300px] px-5 pb-24 pt-28 sm:px-8">
    <h1 class="text-title">Motion pieces</h1>
    <p class="mt-3 max-w-[64ch] text-muted">
      Four live loops and two transparent bursts. The loops are the compositions themselves, running in the page; with reduced motion on they
      are videos that wait for you to press play. The bursts are videos with an alpha channel and do nothing with reduced motion on.
    </p>

    <h2 class="mt-12 text-2xl">Loops</h2>
    <div class="mt-5 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        loops.map((loop) => (
          <figure>
            <HfPlayer name={loop.name} label={loop.label} class="sticker rounded-[32px]" />
            <figcaption class="mt-4 font-display font-semibold">{loop.title}</figcaption>
          </figure>
        ))
      }
    </div>

    <h2 class="mt-14 text-2xl">Bursts</h2>
    <div class="mt-5 flex flex-wrap gap-3">
      {
        bursts.map((burst) => (
          <button type="button" class="hp-btn" data-burst={burst.name}>
            {burst.title}
          </button>
        ))
      }
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <figure>
        <div class="sticker relative aspect-square overflow-hidden rounded-[32px] bg-cream">
          <p class="absolute inset-x-0 top-1/2 -translate-y-1/2 text-center font-display text-3xl font-bold text-indigo">Closed the tab</p>
          {bursts.map((burst) => <AlphaBurst name={burst.name} class="absolute inset-0 h-full w-full" />)}
        </div>
        <figcaption class="mt-4 font-display font-semibold">Over cream</figcaption>
      </figure>
      <figure>
        <div class="sticker relative aspect-square overflow-hidden rounded-[32px] bg-night">
          <p class="absolute inset-x-0 top-1/2 -translate-y-1/2 text-center font-display text-3xl font-bold text-cream">Closed the tab</p>
          {bursts.map((burst) => <AlphaBurst name={burst.name} class="absolute inset-0 h-full w-full" />)}
        </div>
        <figcaption class="mt-4 font-display font-semibold">Over night</figcaption>
      </figure>
    </div>
  </section>
</Base>

<script>
  import { playBurst, warmBurst } from "@/behaviours/alpha-burst";

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-burst]")) {
    const name = button.dataset.burst ?? "";
    button.addEventListener("pointerenter", () => warmBurst(name), { once: true });
    button.addEventListener("click", () => playBurst(name));
  }
</script>
